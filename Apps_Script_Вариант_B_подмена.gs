function main() {
  const ss = SpreadsheetApp.openById(TARGET_SHEET_ID);
  Logger.log('Открыта таблица: ' + ss.getName());

  // === Шаг 1. Переименование старого _Advice_SEO_Draft ===
  const oldDraft = ss.getSheetByName('_Advice_SEO_Draft');
  const archivedName = '_Advice_SEO_Draft' + OLD_SUFFIX;
  const archivedExisting = ss.getSheetByName(archivedName);

  if (oldDraft && !archivedExisting) {
    oldDraft.setName(archivedName);
    Logger.log('Переименован _Advice_SEO_Draft -> ' + archivedName);
  } else if (oldDraft && archivedExisting) {
    // оба есть — оставляем как есть, не теряем данные. Уведомим в логе.
    Logger.log('ВНИМАНИЕ: одновременно есть _Advice_SEO_Draft и архивный ' + archivedName + '. Архив уже существует, текущий лист НЕ переименовываю. Если нужно — удалите вручную и перезапустите.');
  } else if (!oldDraft && archivedExisting) {
    Logger.log('Старого _Advice_SEO_Draft нет, архивный ' + archivedName + ' уже есть — переименование не требуется.');
  } else {
    Logger.log('Нет ни _Advice_SEO_Draft, ни архивного — переименование не требуется.');
  }

  // === Шаг 2. Создание/перезапись новых листов ===
  writeSheet(ss, '_WB_Char_Dict', DATA_WB_CHAR_DICT);
  writeSheet(ss, '_Advice_SEO_Draft', DATA_ADVICE_SEO_DRAFT);

  Logger.log('Готово.');
}

/**
 * Создаёт лист, если его нет; если есть — очищает и заполняет.
 */
function writeSheet(ss, name, rows) {
  let sheet = ss.getSheetByName(name);
  if (sheet) {
    Logger.log('Лист ' + name + ' уже существует — очищаю и перезаписываю.');
    sheet.clear();
  } else {
    sheet = ss.insertSheet(name);
    Logger.log('Создан лист ' + name);
  }
  if (!rows || rows.length === 0) {
    Logger.log('Пустые данные для ' + name + ' — пропускаю заполнение.');
    return;
  }
  const numRows = rows.length;
  const numCols = rows[0].length;
  // выровняем все строки по numCols (на всякий случай)
  const padded = rows.map(r => {
    const rr = r.slice();
    while (rr.length < numCols) rr.push('');
    return rr;
  });
  sheet.getRange(1, 1, numRows, numCols).setValues(padded);
  // жирный заголовок
  sheet.getRange(1, 1, 1, numCols).setFontWeight('bold');
  sheet.setFrozenRows(1);
  Logger.log('Заполнен ' + name + ': ' + numRows + ' x ' + numCols);
}
